{
    "langrev": "1",
    "warnings": ["no-unused"],
    "dependency-search-paths": ["lib"],
    "dependencies": ["raylib55", "nk", "ev", "sqlite3", "fons"],
    "authors": ["LowByteFox"],
    "version": "0.3.0",
    "test-sources": ["test/**"],
    "output": "build",
    
    "targets": {
        "OpenPNGStudio": {
            "type": "static-lib",
            "name": "libOpenPNGStudio",
            "output": "build/src",
            "sources": ["src/**", "assets/cooked_assets.c3"]
        },
        "opng": {
            "type": "static-lib",
            "name": "libopng",
            "dependencies-override": ["sqlite3"],
            "linked-libraries-override": ["sqlite3"],
            "sources": ["src/opng/**"],
            "features": ["OPNG_STANDALONE"],
            "test-sources-override": ["test/opng/**"],
            "output": "build/src/opng"
        },
        "oxy_reporter": {
            "type": "static-lib",
            "name": "liboxy_reporter",
            "dependencies-override": ["raylib55"],
            "sources": ["src/oxy_reporter/**"],
            "features": ["OXY_REPORTER_STANDALONE"],
            "output": "build/src/oxy_reporter"
        }
    },
    
    "cpu": "generic",
    "opt": "O0",
    "features": [],
    "quiet": true
}
